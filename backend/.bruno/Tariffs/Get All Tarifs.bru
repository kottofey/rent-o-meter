meta {
  name: Get All Tarifs
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/tarifs?scopes[tarifs:actualBetween][dateStart]=2025-06-26&scopes[tarifs:actualBetween][dateEnd]=2025-07-26
  body: none
  auth: inherit
}

params:query {
  "scopes[tarifs:actualBetween][dateStart]": 2025-06-26
  "scopes[tarifs:actualBetween][dateEnd]": 2025-07-26
  ~"scopes[tarifs:byType]": electricity
  ~"scopes[tarifs:actualOnDate]": 2025-05-25
}

settings {
  encodeUrl: true
  timeout: 0
}
